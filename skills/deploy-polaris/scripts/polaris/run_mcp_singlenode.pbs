#!/bin/bash -l
# Baseline: 1 node, ONE A100 GPU, HTTP MCP server. Proves the stack boots on
# Polaris. Does NOT scale -- `python -m agentic_execution.mcp_server` builds a
# local Parsl config that caps the 'gpu' executor at a single worker, so this
# uses 1 of the node's 4 GPUs. Use run_mcp_scaling.pbs for the real campaign.
#
#   qsub skills/deploy-polaris/scripts/polaris/run_mcp_singlenode.pbs
#
#PBS -A FRAME-IDP
#PBS -N agentic-exec-mcp
#PBS -l select=1:system=polaris
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:grand
#PBS -l place=scatter
#PBS -q debug
#PBS -j oe

set -euo pipefail

# --- project + environment ---------------------------------------------------
# Must live on a Polaris-mounted filesystem (home/grand/eagle) -- /lus/flare is
# Aurora-only. Adjust to wherever the package is installed on Polaris.
PROJECT_DIR=/lus/grand/projects/FRAME-IDP/msinclair/software/AgenticExecution
cd "$PROJECT_DIR"

module use /soft/modulefiles
module load cudatoolkit-standalone/12.4.1
export TMPDIR=/tmp                      # keep AF_UNIX socket paths short

# Activate the uv venv AFTER `module load` so its `python` wins on PATH.
source "$PROJECT_DIR/.venv/bin/activate"

HOST=$(hostname -i | awk '{print $1}')
PORT=8000

echo "AgenticExecution MCP (single node, 1 GPU) -> http://${HOST}:${PORT}/mcp"

# Bind to the routable HSN IP so other compute-node jobs can reach it.
AGENTIC_EXECUTION_OUTPUT=./execution_output \
python -m agentic_execution.mcp_server \
    --transport http --host "$HOST" --port "$PORT" \
    > agentic-exec-mcp.log 2>&1
